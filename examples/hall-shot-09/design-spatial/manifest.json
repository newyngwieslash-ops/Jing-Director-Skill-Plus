    },
    {
      "id": "RW-001:S009:frame:S009-trigger",
      "kind": "image",
      "path": null,
      "sha256": null,
      "display_height": 400,
      "review_label": "合同声明 unreviewed（未核验）",
      "declared_reviewed_sha256": null
    },
    {
      "id": "RW-001:S009:frame:S009-trigger:state",
      "kind": "text",
      "text": "向右平移到停止机位的时刻。男孩仍在运动中，前方底座与右侧讲解组保持空间区分。"
    },
    {
      "id": "RW-001:S009:frame:S009-trigger:review",
      "kind": "text",
      "text": "合同声明 unreviewed（未核验）"
    },
    {
      "id": "RW-001:S009:frame:S009-development:label",
      "kind": "text",
      "text": "S009-development / development / 7s"
    },
    {
      "id": "RW-001:S009:frame:S009-development",
      "kind": "image",
      "path": null,
      "sha256": null,
      "display_height": 400,
      "review_label": "合同声明 unreviewed（未核验）",
      "declared_reviewed_sha256": null
    },
    {
      "id": "RW-001:S009:frame:S009-development:state",
      "kind": "text",
      "text": "固定机位下，男孩比上一状态更靠近右侧底座前区域，鞋与地缝尚未发生绊脚接触；绣面和展架仍完整。"
    },
    {
      "id": "RW-001:S009:frame:S009-development:review",
      "kind": "text",
      "text": "合同声明 unreviewed（未核验）"
    },
    {
      "id": "RW-001:S009:frame:S009-exit:label",
      "kind": "text",
      "text": "S009-exit / exit / 10s"
    },
    {
      "id": "RW-001:S009:frame:S009-exit",
      "kind": "image",
      "path": null,
      "sha256": null,
      "display_height": 400,
      "review_label": "合同声明 unreviewed（未核验）",
      "declared_reviewed_sha256": null
    },
    {
      "id": "RW-001:S009:frame:S009-exit:state",
      "kind": "text",
      "text": "固定机位末态。男孩在右前景底座前，尚未绊倒或撞架；单一蓝色气球在前上方、细线缠腕，成人群组不移位。"
    },
    {
      "id": "RW-001:S009:frame:S009-exit:review",
      "kind": "text",
      "text": "合同声明 unreviewed（未核验）"
    },
    {
      "id": "RW-001:S009:beats:0:timing",
      "kind": "text",
      "text": "beats 0–2s / 完整原项；跨窗重复仅供上下文"
    },
    {
      "id": "RW-001:S009:beats:0:action",
      "kind": "text",
      "text": "男孩追着前上方气球向右跑，成人两组保持背景位置。"
    },
    {
      "id": "RW-001:S009:beats:0:camera",
      "kind": "text",
      "text": "摄影机向右短距平移跟随，底座与远处展柜产生可见视差。"
    },
    {
      "id": "RW-001:S009:beats:0:sound",
      "kind": "text",
      "text": "急促脚步、小孩笑声和气球拍打声。"
    },
    {
      "id": "RW-001:S009:beats:1:timing",
      "kind": "text",
      "text": "beats 2–7s / 完整原项；跨窗重复仅供上下文"
    },
    {
      "id": "RW-001:S009:beats:1:action",
      "kind": "text",
      "text": "男孩沿真实可行的横向通道继续向右，前方底座留在画面内，细线一直缠腕。"
    },
    {
      "id": "RW-001:S009:beats:1:camera",
      "kind": "text",
      "text": "摄影机固定，不继续跟移，不推近，不改变拍摄轴侧。"
    },
    {
      "id": "RW-001:S009:beats:1:sound",
      "kind": "text",
      "text": "脚步和气球声连续，保留较轻的展厅环境声，不添加可辨认的新台词。"
    },
    {
      "id": "RW-001:S009:beats:2:timing",
      "kind": "text",
      "text": "beats 7–10s / 完整原项；跨窗重复仅供上下文"
    },
    {
      "id": "RW-001:S009:beats:2:action",
      "kind": "text",
      "text": "男孩继续向右到达底座前的区域，尚未绊倒、碰撞或改变展架状态。"
    },
    {
      "id": "RW-001:S009:beats:2:camera",
      "kind": "text",
      "text": "保持固定中远景，让男孩、前方底座及地面关系同框收尾。"
    },
    {
      "id": "RW-001:S009:beats:2:sound",
      "kind": "text",
      "text": "脚步、小孩笑声与气球声结束本镜；不提前出现撞击或碎裂声。"
    },
    {
      "id": "RW-001:S009:soundscape",
      "kind": "text",
      "text": "室内展厅的轻微人群底噪、脚步与气球声；没有可辨认的额外对白。"
    }
