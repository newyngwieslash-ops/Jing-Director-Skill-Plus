    {
      "id": "RW-001:S009:frame:S009-entry:state",
      "kind": "text",
      "text": "男孩刚进入左前景。气球在前上方；成人分组、前景路线和前方底座同时可读。"
    },
    {
      "id": "RW-001:S009:frame:S009-entry:review",
      "kind": "text",
      "text": "合同声明 unreviewed（未核验）"
    },
    {
      "id": "RW-001:S009:frame:S009-trigger:label",
