{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Project character diagram identities",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "revision",
    "characters"
  ],
  "properties": {
    "schema_version": {
      "const": "character-identity-1"
    },
    "project_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "characters": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "character_id",
          "short_code",
          "color",
          "marker_shape",
          "path_style"
        ],
        "properties": {
          "character_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "short_code": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9]{0,7}$"
          },
          "color": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$"
          },
          "marker_shape": {
            "enum": [
              "circle",
              "square",
              "diamond",
              "triangle"
            ]
          },
          "path_style": {
            "enum": [
              "solid",
              "dashed",
              "dotted"
            ]
          }
        }
      }
    }
  },
  "$comment": "Runtime additionally checks trimmed IDs, unique IDs/codes, exact binding, current cast color equality, co-present color+shape collisions and bounded pair comparisons. Colors/shape alone do not certify accessibility."
}
