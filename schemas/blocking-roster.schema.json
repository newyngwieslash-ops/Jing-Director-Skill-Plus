{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "blocking-roster.schema.json",
  "title": "Source-bound typed blocking roster",
  "description": "Counts and source evidence are declared assertions; exact excerpts prove traceability, not semantic authenticity. Runtime also checks contract hash, every subject, exact group count, scene expansion and source evidence.",
  "type": "object",
  "required": [
    "schema_version",
    "contract_sha256",
    "subjects",
    "scenes"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "contract_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "subjects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "subject_id",
          "kind",
          "member_ids",
          "expected_count",
          "evidence"
        ],
        "properties": {
          "subject_id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "individual",
              "group",
              "non_character"
            ]
          },
          "member_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "expected_count": {
            "type": "integer",
            "minimum": 0
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "source_shot_no",
                "field",
                "quote"
              ],
              "properties": {
                "source_shot_no": {
                  "type": "string",
                  "minLength": 1
                },
                "field": {
                  "enum": [
                    "action",
                    "notes",
                    "narrative_intent"
                  ]
                },
                "quote": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "individual"
                }
              }
            },
            "then": {
              "properties": {
                "expected_count": {
                  "const": 1
                },
                "member_ids": {
                  "minItems": 1,
                  "maxItems": 1
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "group"
                }
              }
            },
            "then": {
              "properties": {
                "expected_count": {
                  "minimum": 2
                },
                "member_ids": {
                  "minItems": 2
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "non_character"
                }
              }
            },
            "then": {
              "properties": {
                "expected_count": {
                  "const": 0
                },
                "member_ids": {
                  "minItems": 0,
                  "maxItems": 0
                }
              }
            }
          }
        ]
      }
    },
    "scenes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "scene_id",
          "cast_ids",
          "expected_count"
        ],
        "properties": {
          "scene_id": {
            "type": "string",
            "minLength": 1
          },
          "cast_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "expected_count": {
            "type": "integer",
            "minimum": 0
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
