            "maxLength": 100
          },
          "shot_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "maxItems": 10000
          },
          "reason": {
            "type": "string",
            "maxLength": 10000
          },
          "proposed_change": {
            "type": "string",
            "maxLength": 10000
          },
          "state": {
