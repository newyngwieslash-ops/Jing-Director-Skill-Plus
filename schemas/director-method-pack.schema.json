                    "layer": {
                      "enum": [
                        "RT",
                        "AMB",
                        "FOL",
                        "SFX",
                        "MUS",
                        "DIALOGUE"
                      ]
                    },
                    "start_frame": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 100000000
                    },
                    "end_frame": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 100000000
                    },
                    "description": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "classification",
                        "text",
                        "evidence"
                      ],
                      "properties": {
                        "classification": {
                          "enum": [
                            "source",
                            "inference",
                            "unknown"
                          ]
                        },
                        "text": {
                          "type": "string",
                          "maxLength": 10000
                        },
                        "evidence": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "additionalProperties": false,
                            "required": [
                              "pointer",
                              "value"
                            ],
                            "properties": {
                              "pointer": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 500
                              },
                              "value": {}
                            }
                          },
                          "maxItems": 20
                        }
                      }
                    },
                    "space": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "relation",
                        "role_id",
                        "position"
                      ],
                      "properties": {
                        "relation": {
                          "enum": [
                            "unknown",
                            "onscreen",
                            "offscreen",
                            "nondiegetic"
                          ]
                        },
                        "role_id": {
                          "type": [
                            "string",
                            "null"
                          ],
                          "maxLength": 100
                        },
                        "position": {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "classification",
                            "text",
                            "evidence"
                          ],
                          "properties": {
                            "classification": {
                              "enum": [
                                "source",
                                "inference",
                                "unknown"
                              ]
                            },
                            "text": {
                              "type": "string",
                              "maxLength": 10000
                            },
                            "evidence": {
                              "type": "array",
                              "items": {
                                "type": "object",
                                "additionalProperties": false,
                                "required": [
                                  "pointer",
                                  "value"
                                ],
                                "properties": {
                                  "pointer": {
                                    "type": "string",
                                    "minLength": 1,
                                    "maxLength": 500
                                  },
                                  "value": {}
                                }
                              },
                              "maxItems": 20
                            }
                          }
                        }
                      }
                    },
                    "asset_ref": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "maxLength": 500
                    }
                  }
                },
                "maxItems": 1000
              }
            }
          },
          "edit": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source_in_frame",
              "source_out_frame",
              "program_in_frame",
              "program_out_frame",
              "transition",
              "retime"
            ],
            "properties": {
              "source_in_frame": {
                "const": 0
              },
              "source_out_frame": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 100000000
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "program_in_frame": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 100000000
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "program_out_frame": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 100000000
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "transition": {
                "const": "cut"
              },
              "retime": {
                "const": false
              }
            }
          }
        }
      },
      "maxItems": 1000
    },
    "change_requests": {
      "type": "array",
      "items": {
        "type": "object",
