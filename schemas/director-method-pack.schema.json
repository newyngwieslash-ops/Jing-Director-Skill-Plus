              "source_soundscape": {
                "type": "object"
              },
              "source_music": {
                "type": "object"
              },
              "cues": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "cue_id",
                    "layer",
                    "start_frame",
                    "end_frame",
                    "description",
                    "space",
                    "asset_ref"
                  ],
                  "properties": {
                    "cue_id": {
                      "type": "string",
